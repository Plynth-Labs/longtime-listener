# Copy this file to .env and fill in the two required keys.
# Anything already exported in your shell takes precedence over this file.

# Required: writes the hosts' scripts.
ANTHROPIC_API_KEY=
# Required: web research, speech and transcription.
OPENAI_API_KEY=

# Optional: raises the keyless NewsMCP allowance used by the news preset.
# NEWSMCP_API_KEY=

# Recommended: Wikipedia asks clients to identify themselves with a contact.
# NEWSCAST_USER_AGENT=longtime-listener/0.2 (you@example.com)
